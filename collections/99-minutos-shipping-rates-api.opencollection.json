          "http": {
            "method": "GET",
            "url": "https://delivery.99minutos.com/api/v3/shipping/rates/sizes",
            "params": [
              {
                "name": "depth",
                "value": "",
                "type": "query",
                "description": "Package depth"
              },
              {
                "name": "height",
                "value": "",
                "type": "query",
                "description": "Package height"
              },
              {
                "name": "weight",
                "value": "",
                "type": "query",
                "description": "Package weight"
              },
              {
                "name": "width",
                "value": "",
                "type": "query",
                "description": "Package width"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
