          "name": "calculate shipping rates",
          "request": {
            "name": "calculate shipping rates",
            "description": {
              "content": "Estimate shipping cost and validate coverage based on origin and destination, package dimensions, and weight. If the country is different from Mexico, the zipcode must be empty, and validation will be done using coordinates only.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "shipping",
                "rates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"withTaxes\": \"<boolean>\",\n  \"validateOnlyCoordinates\": \"<boolean>\",\n  \"origin\": {\n    \"country\": \"<string>\",\n    \"codePostal\": \"<string>\"\n  },\n  \"destination\": {\n    \"country\": \"<string>\",\n    \"codePostal\": \"<string>\"\n  },\n  \"items\": [\n    {\n      \"weight\": \"<integer>\",\n      \"depth\": \"<integer>\",\n      \"width\": \"<integer>\",\n      \"height\": \"<integer>\",\n      \"size\": \"<string>\"\n    },\n    {\n      \"weight\": \"<integer>\",\n      \"depth\": \"<integer>\",\n      \"width\": \"<integer>\",\n      \"height\": \"<integer>\",\n      \"size\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
